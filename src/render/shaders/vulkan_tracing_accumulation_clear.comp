#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) writeonly buffer ColorSums {
  vec4 colorSums[];
};

layout(std430, binding = 1) writeonly buffer SampleCounts {
  uint sampleCounts[];
};

layout(std430, binding = 2) writeonly buffer SecondMoments {
  vec4 secondMoments[];
};

layout(std430, binding = 3) readonly buffer Params {
  uint params[];
};

void main() {
  const uint index = gl_GlobalInvocationID.x;
  const uint pixelCount = params[0];
  const bool hasSecondMoment = params[1] != 0u;
  if (index >= pixelCount) {
    return;
  }

  colorSums[index] = vec4(0.0);
  sampleCounts[index] = 0u;
  if (hasSecondMoment) {
    secondMoments[index] = vec4(0.0);
  }
}
