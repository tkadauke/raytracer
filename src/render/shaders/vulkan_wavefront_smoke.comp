#version 450

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer SmokeInput {
  uint rayIds[];
};

layout(std430, binding = 1) writeonly buffer SmokeOutput {
  uint outputIds[];
};

void main() {
  const uint index = gl_GlobalInvocationID.x;
  outputIds[index] = rayIds[index] ^ 0xa5a5a5a5u;
}
