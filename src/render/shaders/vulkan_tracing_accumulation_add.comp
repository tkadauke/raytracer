#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) buffer ColorSums {
  vec4 colorSums[];
};

layout(std430, binding = 1) buffer SampleCounts {
  uint sampleCounts[];
};

layout(std430, binding = 2) buffer SecondMoments {
  vec4 secondMoments[];
};

layout(std430, binding = 3) readonly buffer SampleColors {
  vec4 sampleColors[];
};

layout(std430, binding = 4) readonly buffer Params {
  uint params[];
};

void main() {
  const uint index = gl_GlobalInvocationID.x;
  const uint pixelCount = params[0];
  const bool hasSecondMoment = params[1] != 0u;
  if (index >= pixelCount) {
    return;
  }

  const vec4 color = sampleColors[index];
  colorSums[index] += vec4(color.rgb, 0.0);
  sampleCounts[index] += 1u;
  if (hasSecondMoment) {
    secondMoments[index] += vec4(color.rgb * color.rgb, 0.0);
  }
}
