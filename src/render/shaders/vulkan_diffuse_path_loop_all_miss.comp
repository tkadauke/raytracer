#version 450
#extension GL_GOOGLE_include_directive : require

#include "vulkan_diffuse_path_loop_common.glsl"

void main() {
  const uint id = gl_GlobalInvocationID.x;
  if (id == 0u) {
    echoedParameters = parameters;
  }
  if (id >= parameters.initialPathCount) {
    return;
  }

  GpuDiffusePathStateRecord path = initialPathFor(id);
  if (pathStateIsActive(path) && path.depth >= parameters.maxDepth) {
    path.flags = terminatedPathFlags(path.flags);
    writeAccumulation(id, path);
  }

  for (uint depthIndex = 0u; depthIndex != parameters.maxDepth; ++depthIndex) {
    if (!pathStateIsActive(path) || path.depth >= parameters.maxDepth) {
      break;
    }

    if (parameters.captureMetrics != 0u) {
      atomicAdd(activePathCounts[path.depth], 1u);
    }
    GpuIntersectionHitRecord hit;
    GpuDiffusePathStateRecord next;
    const GpuDiffusePathStepRecord step = pathStep(id, path, hit, next);
    writeDenoiserFeature(path, hit);
    if (parameters.captureDiagnostics != 0u) {
      stepRecords[id * parameters.maxDepth + depthIndex] = step;
    }

    if (pathStateIsActive(path) &&
        (next.flags & gpuDiffusePathStateTerminatedFlag) != 0u) {
      writeAccumulation(id, next);
    }
    if (pathStateIsActive(next) && next.depth >= parameters.maxDepth) {
      next.flags = terminatedPathFlags(next.flags);
      writeAccumulation(id, next);
    }
    path = next;
  }

  if (parameters.captureDiagnostics != 0u) {
    activePathStates[id] = path;
    nextPathStates[id] = path;
  }
  recordRetainedActivePath(id, path);
}
