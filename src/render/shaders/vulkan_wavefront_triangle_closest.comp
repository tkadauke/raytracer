#version 450

const uint leafNodeFlag = 1u;
const uint triangleKind = 1u;
const uint sphereKind = 2u;
const uint planeKind = 3u;
const uint rectangleKind = 4u;
const uint diskKind = 5u;
const uint openCylinderKind = 6u;
const uint torusKind = 7u;
const float kernelEpsilon = 1.1920928955078125e-7;

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

struct Bounds {
  vec4 minimum;
  vec4 maximum;
};

struct BvhNode {
  Bounds bounds;
  uint leftOrFirstPrimitive;
  uint primitiveCount;
  uint flags;
  uint reserved;
};

struct PrimitiveRecord {
  Bounds bounds;
  uint kind;
  uint material;
  uint object;
  uint transform;
  uint payloadOffset;
  uint payloadCount;
  uint reserved0;
  uint reserved1;
};

struct TrianglePayload {
  vec4 point0;
  vec4 point1;
  vec4 point2;
  vec4 normal0;
  vec4 normal1;
  vec4 normal2;
  vec4 uv0;
  vec4 uv1;
  vec4 uv2;
  vec4 minimumHitDistance;
};

struct SpherePayload {
  vec4 centerRadius;
};

struct PlanePayload {
  vec4 normalDistance;
};

struct RectanglePayload {
  vec4 corner;
  vec4 leg1;
  vec4 leg2;
  vec4 normal;
};

struct DiskPayload {
  vec4 centerRadius;
  vec4 normalMinimumHitDistance;
};

struct OpenCylinderPayload {
  vec4 radiusHalfHeight;
};

struct TorusPayload {
  vec4 sweptTubeRadius;
};

struct TransformPayload {
  vec4 pointMatrix0;
  vec4 pointMatrix1;
  vec4 pointMatrix2;
  vec4 pointMatrix3;
  vec4 normalMatrix0;
  vec4 normalMatrix1;
  vec4 normalMatrix2;
  vec4 normalMatrix3;
  vec4 inversePointMatrix0;
  vec4 inversePointMatrix1;
  vec4 inversePointMatrix2;
  vec4 inversePointMatrix3;
  vec4 inverseDirectionMatrix0;
  vec4 inverseDirectionMatrix1;
  vec4 inverseDirectionMatrix2;
  vec4 inverseDirectionMatrix3;
};

struct RayRecord {
  vec4 origin;
  vec4 direction;
  float minDistance;
  float maxDistance;
  float timeSample;
  uint flags;
  uint rayIndex;
  uint reserved0;
  uint reserved1;
  uint reserved2;
};

struct HitRecord {
  uint hit;
  uint material;
  uint object;
  uint primitiveRecord;
  uint rayIndex;
  uint reservedId0;
  uint reservedId1;
  uint reservedId2;
  float distance;
  float reservedDistance0;
  float reservedDistance1;
  float reservedDistance2;
  vec4 point;
  vec4 normal;
  vec4 uv;
  vec4 barycentric;
};

struct LocalHit {
  bool hit;
  float distance;
  vec4 point;
  vec4 normal;
  vec4 uv;
  vec4 barycentric;
};

layout(std430, binding = 0) readonly buffer BvhBuffer {
  BvhNode bvh[];
};

layout(std430, binding = 1) readonly buffer PrimitiveBuffer {
  PrimitiveRecord primitives[];
};

layout(std430, binding = 2) readonly buffer TriangleBuffer {
  TrianglePayload triangles[];
};

layout(std430, binding = 3) readonly buffer SphereBuffer {
  SpherePayload spheres[];
};

layout(std430, binding = 4) readonly buffer PlaneBuffer {
  PlanePayload planes[];
};

layout(std430, binding = 5) readonly buffer RectangleBuffer {
  RectanglePayload rectangles[];
};

layout(std430, binding = 6) readonly buffer DiskBuffer {
  DiskPayload disks[];
};

layout(std430, binding = 7) readonly buffer OpenCylinderBuffer {
  OpenCylinderPayload openCylinders[];
};

layout(std430, binding = 8) readonly buffer TorusBuffer {
  TorusPayload tori[];
};

layout(std430, binding = 9) readonly buffer TransformBuffer {
  TransformPayload transforms[];
};

layout(std430, binding = 10) readonly buffer RayBuffer {
  RayRecord rays[];
};

layout(std430, binding = 11) writeonly buffer HitBuffer {
  HitRecord hits[];
};

layout(std430, binding = 12) readonly buffer CountBuffer {
  uvec4 counts0;
  uvec4 counts1;
  uvec4 counts2;
};

float positiveInfinity() {
  return uintBitsToFloat(0x7f800000u);
}

LocalHit makeLocalMiss() {
  LocalHit result;
  result.hit = false;
  result.distance = positiveInfinity();
  result.point = vec4(0.0);
  result.normal = vec4(0.0);
  result.uv = vec4(0.0);
  result.barycentric = vec4(0.0);
  return result;
}

HitRecord makeMiss(RayRecord ray) {
  HitRecord record;
  record.hit = 0u;
  record.material = 0u;
  record.object = 0u;
  record.primitiveRecord = 0u;
  record.rayIndex = ray.rayIndex;
  record.reservedId0 = 0u;
  record.reservedId1 = 0u;
  record.reservedId2 = 0u;
  record.distance = positiveInfinity();
  record.reservedDistance0 = 0.0;
  record.reservedDistance1 = 0.0;
  record.reservedDistance2 = 0.0;
  record.point = vec4(0.0);
  record.normal = vec4(0.0);
  record.uv = vec4(0.0);
  record.barycentric = vec4(0.0);
  return record;
}

float boundsEntryDistance(Bounds bounds, RayRecord ray, float maxHitDistance) {
  float enter = ray.minDistance;
  float exit = min(ray.maxDistance, maxHitDistance);
  if (exit < enter) {
    return positiveInfinity();
  }

  for (uint axis = 0u; axis != 3u; ++axis) {
    const float origin = ray.origin[axis];
    const float direction = ray.direction[axis];
    const float minimum = bounds.minimum[axis];
    const float maximum = bounds.maximum[axis];
    if (abs(direction) <= kernelEpsilon) {
      if (origin < minimum || origin > maximum) {
        return positiveInfinity();
      }
      continue;
    }

    const float inverseDirection = 1.0 / direction;
    float nearDistance = (minimum - origin) * inverseDirection;
    float farDistance = (maximum - origin) * inverseDirection;
    if (nearDistance > farDistance) {
      const float temporary = nearDistance;
      nearDistance = farDistance;
      farDistance = temporary;
    }

    enter = max(enter, nearDistance);
    exit = min(exit, farDistance);
    if (exit < enter) {
      return positiveInfinity();
    }
  }
  return enter;
}

bool boundsIntersect(Bounds bounds, RayRecord ray, float maxHitDistance) {
  return boundsEntryDistance(bounds, ray, maxHitDistance) < positiveInfinity();
}

vec4 normalize3(vec4 value) {
  const float lengthSquared = dot(value.xyz, value.xyz);
  if (lengthSquared <= kernelEpsilon) {
    return vec4(0.0);
  }
  return vec4(value.xyz * inversesqrt(lengthSquared), 0.0);
}

vec4 transformPoint(vec4 row0, vec4 row1, vec4 row2, vec4 row3, vec4 point) {
  return vec4(dot(row0, point), dot(row1, point), dot(row2, point), dot(row3, point));
}

vec4 transformDirection(vec4 row0, vec4 row1, vec4 row2, vec4 direction) {
  return vec4(dot(row0.xyz, direction.xyz), dot(row1.xyz, direction.xyz),
              dot(row2.xyz, direction.xyz), 0.0);
}

RayRecord transformRay(RayRecord ray, TransformPayload transform) {
  RayRecord result = ray;
  result.origin =
    transformPoint(transform.inversePointMatrix0, transform.inversePointMatrix1,
                   transform.inversePointMatrix2, transform.inversePointMatrix3, ray.origin);
  result.direction =
    transformDirection(transform.inverseDirectionMatrix0, transform.inverseDirectionMatrix1,
                       transform.inverseDirectionMatrix2, ray.direction);
  return result;
}

LocalHit transformHit(LocalHit hit, TransformPayload transform) {
  if (!hit.hit) {
    return hit;
  }

  hit.point = transformPoint(transform.pointMatrix0, transform.pointMatrix1, transform.pointMatrix2,
                             transform.pointMatrix3, hit.point);
  hit.normal = normalize3(transformDirection(transform.normalMatrix0, transform.normalMatrix1,
                                             transform.normalMatrix2, hit.normal));
  return hit;
}

vec4 interpolate3(vec4 a, vec4 b, vec4 c, float alpha, float beta, float gamma) {
  return a * alpha + b * beta + c * gamma;
}

LocalHit intersectTriangle(RayRecord ray, TrianglePayload triangle) {
  LocalHit result = makeLocalMiss();
  const float a = triangle.point0.x - triangle.point1.x;
  const float b = triangle.point0.x - triangle.point2.x;
  const float c = ray.direction.x;
  const float d = triangle.point0.x - ray.origin.x;
  const float e = triangle.point0.y - triangle.point1.y;
  const float f = triangle.point0.y - triangle.point2.y;
  const float g = ray.direction.y;
  const float h = triangle.point0.y - ray.origin.y;
  const float i = triangle.point0.z - triangle.point1.z;
  const float j = triangle.point0.z - triangle.point2.z;
  const float k = ray.direction.z;
  const float l = triangle.point0.z - ray.origin.z;
  const float m = f * k - g * j;
  const float n = h * k - g * l;
  const float p = f * l - h * j;
  const float q = g * i - e * k;
  const float r = e * l - h * i;
  const float s = e * j - f * i;
  const float denominator = a * m + b * q + c * s;
  if (denominator == 0.0) {
    return result;
  }

  const float invDenom = 1.0 / denominator;
  const float beta = (d * m - b * n - c * p) * invDenom;
  if (beta < 0.0 || beta > 1.0) {
    return result;
  }

  const float gamma = (a * n + d * q + c * r) * invDenom;
  if (gamma < 0.0 || gamma > 1.0 || beta + gamma > 1.0) {
    return result;
  }

  const float distance = (a * p - b * r + d * s) * invDenom;
  const float minimumDistance = max(ray.minDistance, triangle.minimumHitDistance.x);
  if (distance < minimumDistance || distance > ray.maxDistance) {
    return result;
  }

  const float alpha = 1.0 - beta - gamma;
  result.hit = true;
  result.distance = distance;
  result.point = ray.origin + ray.direction * distance;
  result.point.w = 1.0;
  result.normal = normalize3(
    interpolate3(triangle.normal0, triangle.normal1, triangle.normal2, alpha, beta, gamma));
  result.uv = interpolate3(triangle.uv0, triangle.uv1, triangle.uv2, alpha, beta, gamma);
  result.barycentric = vec4(alpha, beta, gamma, 0.0);
  return result;
}

LocalHit intersectSphere(RayRecord ray, SpherePayload sphere) {
  LocalHit result = makeLocalMiss();
  const vec3 center = sphere.centerRadius.xyz;
  const float radius = sphere.centerRadius.w;
  const vec3 origin = ray.origin.xyz - center;
  const vec3 direction = ray.direction.xyz;
  const float od = dot(origin, direction);
  const float dd = dot(direction, direction);
  if (dd <= kernelEpsilon) {
    return result;
  }

  const float originLengthSquared = dot(origin, origin);
  const float discriminant = od * od - dd * (originLengthSquared - radius * radius);
  if (discriminant <= 0.0) {
    return result;
  }

  const float discriminantRoot = sqrt(discriminant);
  const float nearDistance = (-od - discriminantRoot) / dd;
  const float farDistance = (-od + discriminantRoot) / dd;
  if (nearDistance <= 0.0 && farDistance <= 0.0) {
    return result;
  }

  const float distance = nearDistance >= ray.minDistance ? nearDistance : farDistance;
  if (distance < ray.minDistance || distance > ray.maxDistance) {
    return result;
  }

  result.hit = true;
  result.distance = distance;
  result.point = ray.origin + ray.direction * distance;
  result.point.w = 1.0;
  result.normal = normalize3(vec4(result.point.xyz - center, 0.0));
  return result;
}

LocalHit intersectPlane(RayRecord ray, PlanePayload plane) {
  LocalHit result = makeLocalMiss();
  const vec3 normal = plane.normalDistance.xyz;
  const float angle = dot(normal, ray.direction.xyz);
  if (angle == 0.0) {
    return result;
  }

  const float distance = -(dot(normal, ray.origin.xyz) + plane.normalDistance.w) / angle;
  if (distance <= 0.0 || distance < ray.minDistance || distance > ray.maxDistance) {
    return result;
  }

  result.hit = true;
  result.distance = distance;
  result.point = ray.origin + ray.direction * distance;
  result.point.w = 1.0;
  result.normal = vec4(normal, 0.0);
  return result;
}

LocalHit intersectRectangle(RayRecord ray, RectanglePayload rectangle) {
  LocalHit result = makeLocalMiss();
  const vec3 normal = rectangle.normal.xyz;
  const float denominator = dot(ray.direction.xyz, normal);
  if (denominator == 0.0) {
    return result;
  }

  const vec3 cornerToOrigin = rectangle.corner.xyz - ray.origin.xyz;
  const float distance = dot(cornerToOrigin, normal) / denominator;
  if (isnan(distance) || isinf(distance) || distance < 0.0 || distance < ray.minDistance ||
      distance > ray.maxDistance) {
    return result;
  }

  const vec4 point = ray.origin + ray.direction * distance;
  const vec3 difference = point.xyz - rectangle.corner.xyz;
  const float dot1 = dot(difference, rectangle.leg1.xyz);
  const float squaredLength1 = dot(rectangle.leg1.xyz, rectangle.leg1.xyz);
  if (dot1 < 0.0 || dot1 > squaredLength1) {
    return result;
  }

  const float dot2 = dot(difference, rectangle.leg2.xyz);
  const float squaredLength2 = dot(rectangle.leg2.xyz, rectangle.leg2.xyz);
  if (dot2 < 0.0 || dot2 > squaredLength2) {
    return result;
  }

  result.hit = true;
  result.distance = distance;
  result.point = point;
  result.point.w = 1.0;
  result.normal = vec4(normal, 0.0);
  return result;
}

LocalHit intersectDisk(RayRecord ray, DiskPayload disk) {
  LocalHit result = makeLocalMiss();
  const vec3 center = disk.centerRadius.xyz;
  const float radius = disk.centerRadius.w;
  const vec3 normal = disk.normalMinimumHitDistance.xyz;
  const float minimumHitDistance = disk.normalMinimumHitDistance.w;
  const float denominator = dot(ray.direction.xyz, normal);
  if (denominator == 0.0) {
    return result;
  }

  const float distance = dot(center - ray.origin.xyz, normal) / denominator;
  if (isnan(distance) || isinf(distance) || distance < minimumHitDistance ||
      distance < ray.minDistance || distance > ray.maxDistance) {
    return result;
  }

  const vec4 point = ray.origin + ray.direction * distance;
  const vec3 hitOffset = point.xyz - center;
  const float squaredDistance = dot(hitOffset, hitOffset);
  if (!(squaredDistance < radius * radius)) {
    return result;
  }

  result.hit = true;
  result.distance = distance;
  result.point = point;
  result.point.w = 1.0;
  result.normal = vec4(normal, 0.0);
  return result;
}

LocalHit intersectOpenCylinder(RayRecord ray, OpenCylinderPayload openCylinder) {
  LocalHit result = makeLocalMiss();
  const float radius = openCylinder.radiusHalfHeight.x;
  const float halfHeight = openCylinder.radiusHalfHeight.y;
  const float inverseRadius = openCylinder.radiusHalfHeight.z;
  const float a = ray.direction.x * ray.direction.x + ray.direction.z * ray.direction.z;
  if (abs(a) <= kernelEpsilon) {
    return result;
  }

  const float b = 2.0 * (ray.origin.x * ray.direction.x + ray.origin.z * ray.direction.z);
  const float c = ray.origin.x * ray.origin.x + ray.origin.z * ray.origin.z - radius * radius;
  const float determinant = b * b - 4.0 * a * c;
  if (determinant <= kernelEpsilon) {
    return result;
  }

  const float determinantRoot = sqrt(determinant);
  const float denominator = 2.0 * a;
  const float distances[2] =
    float[2]((-determinantRoot - b) / denominator, (determinantRoot - b) / denominator);
  float bestDistance = positiveInfinity();
  for (uint index = 0u; index != 2u; ++index) {
    const float distance = distances[index];
    if (distance <= 0.0 || distance < ray.minDistance || distance > ray.maxDistance ||
        distance >= bestDistance) {
      continue;
    }

    const float y = ray.origin.y + ray.direction.y * distance;
    if (y < -halfHeight || y > halfHeight) {
      continue;
    }

    bestDistance = distance;
  }

  if (isnan(bestDistance) || isinf(bestDistance)) {
    return result;
  }

  result.hit = true;
  result.distance = bestDistance;
  result.point = ray.origin + ray.direction * bestDistance;
  result.point.w = 1.0;
  result.normal = vec4(result.point.x * inverseRadius, 0.0, result.point.z * inverseRadius, 0.0);

  const float twoPi = 6.283185307179586;
  float u = atan(result.point.z, result.point.x) / twoPi;
  if (u < 0.0) {
    u += 1.0;
  }
  const float height = 2.0 * halfHeight;
  const float v = height == 0.0 ? 0.0 : (result.point.y + halfHeight) / height;
  result.uv = vec4(u, v, 0.0, 0.0);
  return result;
}

bool almostZero(float value) {
  return abs(value) <= kernelEpsilon * 10.0;
}

float cubeRoot(float value) {
  return value < 0.0 ? -pow(-value, 1.0 / 3.0) : pow(value, 1.0 / 3.0);
}

uint solveQuadric(float a, float b, float c, out float roots[4]) {
  if (almostZero(a)) {
    if (almostZero(b)) {
      return 0u;
    }
    roots[0] = -c / b;
    return 1u;
  }

  const float determinant = b * b - 4.0 * a * c;
  if (almostZero(determinant)) {
    roots[0] = -b / (2.0 * a);
    return 1u;
  }
  if (determinant > 0.0) {
    const float determinantRoot = sqrt(determinant);
    roots[0] = (-determinantRoot - b) / (2.0 * a);
    roots[1] = (determinantRoot - b) / (2.0 * a);
    return 2u;
  }
  return 0u;
}

uint solveCubic(float a, float b, float c, float d, out float roots[4]) {
  if (almostZero(a)) {
    return solveQuadric(b, c, d, roots);
  }

  const float normA = b / a;
  const float normB = c / a;
  const float normC = d / a;
  const float normASquared = normA * normA;
  const float p = (-(1.0 / 3.0) * normASquared + normB) / 3.0;
  const float q = (2.0 / 27.0 * normA * normASquared - (1.0 / 3.0) * normA * normB + normC) / 2.0;
  const float pCube = p * p * p;
  const float determinant = q * q + pCube;
  uint count = 0u;

  if (almostZero(determinant)) {
    if (almostZero(q)) {
      roots[0] = 0.0;
      count = 1u;
    } else {
      const float root = cubeRoot(-q);
      roots[0] = 2.0 * root;
      roots[1] = -root;
      count = 2u;
    }
  } else if (determinant < 0.0) {
    const float pi = 3.14159265358979323846;
    const float phi = acos(clamp(-q / sqrt(-pCube), -1.0, 1.0)) / 3.0;
    const float t = 2.0 * sqrt(-p);
    roots[0] = t * cos(phi);
    roots[1] = -t * cos(phi + pi / 3.0);
    roots[2] = -t * cos(phi - pi / 3.0);
    count = 3u;
  } else {
    const float determinantRoot = sqrt(determinant);
    roots[0] = cubeRoot(determinantRoot - q) - cubeRoot(determinantRoot + q);
    count = 1u;
  }

  const float sub = normA / 3.0;
  for (uint index = 0u; index != count; ++index) {
    roots[index] -= sub;
  }
  return count;
}

uint solveQuartic(float a, float b, float c, float d, float e, out float roots[4]) {
  if (almostZero(a)) {
    return solveCubic(b, c, d, e, roots);
  }

  const float normA = b / a;
  const float normB = c / a;
  const float normC = d / a;
  const float normD = e / a;
  const float normASquared = normA * normA;
  const float p = -3.0 / 8.0 * normASquared + normB;
  const float q = 1.0 / 8.0 * normASquared * normA - 0.5 * normA * normB + normC;
  const float r = -3.0 / 256.0 * normASquared * normASquared + 1.0 / 16.0 * normASquared * normB -
                  0.25 * normA * normC + normD;
  uint count = 0u;

  if (almostZero(r)) {
    float cubicRoots[4];
    const uint cubicCount = solveCubic(1.0, 0.0, p, q, cubicRoots);
    for (uint index = 0u; index != cubicCount; ++index) {
      roots[count++] = cubicRoots[index];
    }
  } else {
    float cubicRoots[4];
    const uint cubicCount = solveCubic(1.0, -0.5 * p, -r, 0.5 * r * p - 0.125 * q * q, cubicRoots);
    if (cubicCount == 0u) {
      return 0u;
    }

    const float z = cubicRoots[0];
    float u = z * z - r;
    float v = 2.0 * z - p;
    const float uTol = kernelEpsilon * 16.0 * (1.0 + abs(z * z) + abs(r));
    const float vTol = kernelEpsilon * 16.0 * (1.0 + abs(2.0 * z) + abs(p));
    if (u < -uTol || v < -vTol) {
      return 0u;
    }

    u = u <= 0.0 ? 0.0 : sqrt(u);
    v = v <= 0.0 ? 0.0 : sqrt(v);

    float quadRoots[4];
    uint quadCount = solveQuadric(1.0, q < 0.0 ? -v : v, z - u, quadRoots);
    for (uint index = 0u; index != quadCount; ++index) {
      roots[count++] = quadRoots[index];
    }
    quadCount = solveQuadric(1.0, q < 0.0 ? v : -v, z + u, quadRoots);
    for (uint index = 0u; index != quadCount; ++index) {
      roots[count++] = quadRoots[index];
    }
  }

  const float sub = 0.25 * normA;
  for (uint index = 0u; index != count; ++index) {
    roots[index] -= sub;
  }
  for (uint i = 1u; i < count; ++i) {
    const float value = roots[i];
    uint j = i;
    while (j > 0u && roots[j - 1u] > value) {
      roots[j] = roots[j - 1u];
      --j;
    }
    roots[j] = value;
  }
  return count;
}

LocalHit intersectTorus(RayRecord ray, TorusPayload torus) {
  LocalHit result = makeLocalMiss();
  const float sweptRadius = torus.sweptTubeRadius.x;
  const float tubeRadius = torus.sweptTubeRadius.y;
  const float dd = dot(ray.direction.xyz, ray.direction.xyz);
  const float oorr =
    dot(ray.origin.xyz, ray.origin.xyz) - sweptRadius * sweptRadius - tubeRadius * tubeRadius;
  const float od = dot(ray.origin.xyz, ray.direction.xyz);
  const float fourRR = 4.0 * sweptRadius * sweptRadius;

  float roots[4];
  const uint rootCount = solveQuartic(
    dd * dd, 4.0 * dd * od,
    2.0 * dd * oorr + 4.0 * od * od + fourRR * ray.direction.y * ray.direction.y,
    4.0 * od * oorr + 2.0 * fourRR * ray.origin.y * ray.direction.y,
    oorr * oorr - fourRR * (tubeRadius * tubeRadius - ray.origin.y * ray.origin.y), roots);

  float bestDistance = positiveInfinity();
  for (uint index = 0u; index != rootCount; ++index) {
    const float distance = roots[index];
    if (distance <= 0.0 || distance < ray.minDistance || distance > ray.maxDistance ||
        distance >= bestDistance) {
      continue;
    }
    bestDistance = distance;
  }
  if (isnan(bestDistance) || isinf(bestDistance)) {
    return result;
  }

  result.hit = true;
  result.distance = bestDistance;
  result.point = ray.origin + ray.direction * bestDistance;
  result.point.w = 1.0;
  const float paramSquared = sweptRadius * sweptRadius + tubeRadius * tubeRadius;
  const float sumSquared = dot(result.point.xyz, result.point.xyz);
  result.normal = normalize3(
    vec4(4.0 * result.point.x * (sumSquared - paramSquared),
         4.0 * result.point.y * (sumSquared - paramSquared + 2.0 * sweptRadius * sweptRadius),
         4.0 * result.point.z * (sumSquared - paramSquared), 0.0));
  return result;
}

LocalHit intersectPrimitivePayload(RayRecord ray, PrimitiveRecord primitive, uint triangleCount,
                                   uint sphereCount, uint planeCount, uint rectangleCount,
                                   uint diskCount, uint openCylinderCount, uint torusCount) {
  if (primitive.payloadCount != 1u) {
    return makeLocalMiss();
  }

  if (primitive.kind == triangleKind && primitive.payloadOffset < triangleCount) {
    return intersectTriangle(ray, triangles[primitive.payloadOffset]);
  }
  if (primitive.kind == sphereKind && primitive.payloadOffset < sphereCount) {
    return intersectSphere(ray, spheres[primitive.payloadOffset]);
  }
  if (primitive.kind == planeKind && primitive.payloadOffset < planeCount) {
    return intersectPlane(ray, planes[primitive.payloadOffset]);
  }
  if (primitive.kind == rectangleKind && primitive.payloadOffset < rectangleCount) {
    return intersectRectangle(ray, rectangles[primitive.payloadOffset]);
  }
  if (primitive.kind == diskKind && primitive.payloadOffset < diskCount) {
    return intersectDisk(ray, disks[primitive.payloadOffset]);
  }
  if (primitive.kind == openCylinderKind && primitive.payloadOffset < openCylinderCount) {
    return intersectOpenCylinder(ray, openCylinders[primitive.payloadOffset]);
  }
  if (primitive.kind == torusKind && primitive.payloadOffset < torusCount) {
    return intersectTorus(ray, tori[primitive.payloadOffset]);
  }
  return makeLocalMiss();
}

LocalHit intersectPrimitive(RayRecord ray, PrimitiveRecord primitive, uint triangleCount,
                            uint sphereCount, uint planeCount, uint rectangleCount, uint diskCount,
                            uint openCylinderCount, uint torusCount, uint transformCount) {
  if (primitive.transform != 0u) {
    if (primitive.transform >= transformCount) {
      return makeLocalMiss();
    }

    const TransformPayload transform = transforms[primitive.transform];
    return transformHit(intersectPrimitivePayload(
                          transformRay(ray, transform), primitive, triangleCount, sphereCount,
                          planeCount, rectangleCount, diskCount, openCylinderCount, torusCount),
                        transform);
  }

  return intersectPrimitivePayload(ray, primitive, triangleCount, sphereCount, planeCount,
                                   rectangleCount, diskCount, openCylinderCount, torusCount);
}

void writeClosestHit(inout HitRecord closest, RayRecord ray, PrimitiveRecord primitive,
                     uint primitiveIndex, LocalHit hit) {
  closest.hit = 1u;
  closest.material = primitive.material;
  closest.object = primitive.object;
  closest.primitiveRecord = primitiveIndex;
  closest.rayIndex = ray.rayIndex;
  closest.distance = hit.distance;
  closest.point = hit.point;
  closest.normal = hit.normal;
  closest.uv = hit.uv;
  closest.barycentric = hit.barycentric;
}

void main() {
  const uint bvhCount = counts0.x;
  const uint primitiveCount = counts0.y;
  const uint triangleCount = counts0.z;
  const uint sphereCount = counts0.w;
  const uint planeCount = counts1.x;
  const uint rectangleCount = counts1.y;
  const uint diskCount = counts1.z;
  const uint openCylinderCount = counts1.w;
  const uint rayCount = counts2.x;
  const uint transformCount = counts2.y;
  const uint torusCount = counts2.z;
  const uint id = gl_GlobalInvocationID.x;
  if (id >= rayCount) {
    return;
  }

  const RayRecord ray = rays[id];
  HitRecord closest = makeMiss(ray);
  if (bvhCount == 0u || primitiveCount == 0u) {
    hits[id] = closest;
    return;
  }

  uint stack[64];
  uint stackSize = 1u;
  stack[0] = 0u;
  while (stackSize > 0u) {
    const uint nodeIndex = stack[--stackSize];
    if (nodeIndex >= bvhCount) {
      continue;
    }

    const BvhNode node = bvh[nodeIndex];
    if (!boundsIntersect(node.bounds, ray, closest.distance)) {
      continue;
    }

    if ((node.flags & leafNodeFlag) == 0u) {
      const uint leftChild = node.leftOrFirstPrimitive;
      const uint rightChild = node.primitiveCount;
      const float leftEntry = leftChild < bvhCount
                                ? boundsEntryDistance(bvh[leftChild].bounds, ray, closest.distance)
                                : positiveInfinity();
      const float rightEntry =
        rightChild < bvhCount ? boundsEntryDistance(bvh[rightChild].bounds, ray, closest.distance)
                              : positiveInfinity();

      if (stackSize + 2u <= 64u) {
        if (leftEntry < positiveInfinity() && rightEntry < positiveInfinity()) {
          if (leftEntry <= rightEntry) {
            stack[stackSize++] = rightChild;
            stack[stackSize++] = leftChild;
          } else {
            stack[stackSize++] = leftChild;
            stack[stackSize++] = rightChild;
          }
        } else if (leftEntry < positiveInfinity()) {
          stack[stackSize++] = leftChild;
        } else if (rightEntry < positiveInfinity()) {
          stack[stackSize++] = rightChild;
        }
      }
      continue;
    }

    for (uint offset = 0u; offset != node.primitiveCount; ++offset) {
      const uint primitiveIndex = node.leftOrFirstPrimitive + offset;
      if (primitiveIndex >= primitiveCount) {
        continue;
      }

      const PrimitiveRecord primitive = primitives[primitiveIndex];
      if (!boundsIntersect(primitive.bounds, ray, closest.distance)) {
        continue;
      }

      const LocalHit hit =
        intersectPrimitive(ray, primitive, triangleCount, sphereCount, planeCount, rectangleCount,
                           diskCount, openCylinderCount, torusCount, transformCount);
      if (!hit.hit || (closest.hit != 0u && hit.distance >= closest.distance)) {
        continue;
      }
      writeClosestHit(closest, ray, primitive, primitiveIndex, hit);
    }
  }

  hits[id] = closest;
}
